  "changelog": [
    {
      "date": "2026-10-04",
      "text": "أوتو سنك v3.1: يقيس والمعلّق شغّال، يقرأ صوت الجمهور الضعيف، يتجاهل انقطاعات المعلّق، ولا يطبّق التطابق الضعيف إلا بعد قياسين متفقين"
    },
    {
      "date": "2026-10-04",
      "text": "ينتظر استقرار المعلّق دقيقة بعد التشغيل قبل القياس"
    },
    {
      "date": "2026-10-04",
      "text": "حارس انزياح الصورة: يرجّع الصورة لمكانها تلقائياً بعد قفزات الإشارة طوال المباراة"
    },
    {
      "date": "2026-10-04",
      "text": "الزر الأخضر بعد التطبيق يعرض آخر قياس للتعديل اليدوي بدون قياس جديد"
    },
    {
      "date": "2026-10-04",
      "text": "تعديل ثابت يُحفظ لكل قناة صوتية لوحدها (الزر الأزرق)"
    },
    {
      "date": "2026-10-04",
      "text": "Live Info: القنوات والمعلّقين الحقيقيين من jdwel.com مع أعلام وشعارات الفرق وتحديث كل دقيقة"
    },
    {
      "date": "2026-10-04",
      "text": "جدول المباريات (EPG) جنب كل قناة صوتية مع شريط تقدّم المباراة"
    },
    {
      "date": "2026-10-04",
      "text": "مشغل الصوت ipa_core 1.0.6"
    },
    {
      "date": "2026-10-04",
      "text": "سكربت تثبيت جديد يعمل على كل الصور ولا يحذف النسخة القديمة إذا فشل التثبيت"
    }
  ]
